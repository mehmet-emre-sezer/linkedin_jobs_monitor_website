# EC2'de bu dosyayı `.env` olarak kopyala ve gerçek değerleri doldur:
#   cp .env.example .env && nano .env
# .env git'e GİRMEZ. DB_URL'i docker-compose otomatik ayarlar, buraya yazma.

# --- Veritabanı (ZORUNLU) ---
DB_USERNAME=ispusulasi
DB_PASSWORD=degistir_guclu_bir_sifre
DB_NAME=jobradar_db

# --- JWT (ZORUNLU, en az 32 karakter) ---
JWT_SECRET=degistir_en_az_32_karakterlik_rastgele_gizli_anahtar

# --- Gemini LLM (ZORUNLU) ---
GEMINI_API_KEY=

# --- Frontend adresi (email linkleri + CORS) ---
FRONTEND_URL=https://senin-domainin.com
CORS_ORIGINS=https://senin-domainin.com

# --- Telegram (boş = mock mod) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ispusulasi_bot
TELEGRAM_WEBHOOK_SECRET=

# --- Email / Resend (boş = mock mod) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- Google OAuth (boş = Google ile giriş kapalı) ---
GOOGLE_CLIENT_ID=

# --- Proxy / IPRoyal (boş = proxy'siz doğrudan bağlanır) ---
PROXY_HOST=
PROXY_PORT=0
PROXY_USERNAME=
PROXY_PASSWORD=
